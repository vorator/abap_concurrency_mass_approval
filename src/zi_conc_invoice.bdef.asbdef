managed implementation in class zbp_i_conc_invoice unique;
strict ( 2 );
with draft;

define behavior for ZI_conc_INVOICE alias Invoice
persistent table zconc_invoice
draft table zconc_invoice_d
lock master             // pessimistic Locking, locking the object
total etag ModifiedAt
etag master ModifiedAt  // optimistic Locking for user modifications;
                        // compares in-mem date with DB date before action; excludes modif instance
authorization master ( global )
with additional save
{
  create;
  update;
  delete;

  field ( numbering: managed, readonly ) InvoiceId;

  field ( readonly ) CreatedBy, CreatedAt, ModifiedBy, ModifiedAt;

  action ( features : instance ) approveInvoice result [1] $self; // multithread action

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zconc_invoice {
    InvoiceId   = invoice_id;
    InvoiceNo   = invoice_number;
    VendorId    = vendor_id;
    AmountLC    = amount_lc;
    CurrencyLC  = currency_lc;
    AmountEur   = amount_eur;
    CurrencyEur = currency_eur;
    InvoiceDate = invoice_date;
    DcIndicator = dc_indicator;
    Status      = status;
    Description = description;
    CreatedBy   = created_by;
    CreatedAt   = created_at;
    ModifiedBy  = modified_by;
    ModifiedAt  = modified_at;
  }
}