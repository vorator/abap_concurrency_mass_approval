@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Fatura',
    typeNamePlural: 'Faturas',
    title: { type: #STANDARD, value: 'InvoiceNo' },
    description: { type: #STANDARD, value: 'VendorId' }
  }, presentationVariant: [{ sortOrder: [{ by: 'InvoiceDate', direction: #DESC }] }]
}
annotate view ZC_CONC_INVOICE with
{
  @UI.facet: [{ id: 'General',
                purpose: #STANDARD,
                type: #IDENTIFICATION_REFERENCE,
                label: 'Invoice details',
                position: 10
              },
              { id: 'AdminData', 
                purpose: #STANDARD, 
                type: #FIELDGROUP_REFERENCE, 
                targetQualifier: 'AdminGroup', 
                label: 'Administrative Data', 
                position: 20 }]

  @UI.hidden: true
  InvoiceId;

  @UI.lineItem: [
    { position: 10, label: 'Invoice No' },
    { type: #FOR_ACTION, dataAction: 'approveInvoice', label: 'Mass Approval', position: 10 }
  ]
  @UI.identification: [
    { position: 10, label: 'Invoice No' },
    { type: #FOR_ACTION, dataAction: 'approveInvoice', label: 'Invoice approval', position: 10 }
  ]
  @UI.selectionField: [{ position: 10 }]
  InvoiceNo;

  @UI.lineItem:       [{ position: 20, label: 'VendorID' }]
  @UI.identification: [{ position: 20, label: 'VendorID' }]
  @UI.selectionField: [{ position: 20 }]
  VendorId;

  @UI.lineItem:       [{ position: 30 }]
  @UI.identification: [{ position: 30, label: 'Amount' }]
  AmountEur;

  @UI.lineItem:       [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  CurrencyEur;

  @UI.lineItem:       [{ position: 50 }]
  @UI.identification: [{ position: 50, label: 'Status' }]
  @UI.selectionField: [{ position: 30 }]
  Status;

  @UI.lineItem:       [{ position: 60 }]
  @UI.identification: [{ position: 60, label: 'Invoice Date' }]
  InvoiceDate;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 10, label: 'Created by' }]
  CreatedBy;
  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 20, label: 'Created at' }]
  CreatedAt;
   @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 30, label: 'Modif. by' }]
  ModifiedBy;
  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 40, label: 'Modif. at' }]
  ModifiedAt;
}